{
  "manifest_version": 3,
  "name": "Scroll Reels",
  "version": "1.0.0",
  "description": "Navigate Instagram Reels manually or automatically with a time limit.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": {
    "default_title": "Scroll Reels",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "next-reel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "MacCtrl+Shift+Down"
      },
      "description": "Go to the next Instagram Reel"
    },
    "previous-reel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "MacCtrl+Shift+Up"
      },
      "description": "Go to the previous Instagram Reel"
    }
  }
}
